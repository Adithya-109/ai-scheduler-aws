# Copy to .env (git-ignored) and fill in. Environment variables override this file.

# Base URL of the worker on this machine (the "edge" node).
LOCAL_WORKER_URL=http://localhost:8000

# Base URL of the EC2 worker, e.g. http://<elastic-ip>:8000. Leave empty to
# run edge-only. Prefer putting this behind a security group that only allows
# your own IP, or an SSH tunnel / VPN, and TLS if it must be public.
CLOUD_WORKER_URL=

# Shared secret sent as the X-API-Key header. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The worker refuses to listen on a non-loopback address without one.
WORKER_API_KEY=

# --- worker-only settings (set on the machine that runs worker_server.py) ---
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
WORKER_MAX_JOBS=2
WORKER_TIMEOUT_S=30
WORKER_MEM_MB=2048
WORKER_MAX_CODE_BYTES=200000
WORKER_MAX_OUTPUT_BYTES=1000000

# Where the dispatcher appends decisions + measured outcomes (JSON lines).
DECISION_LOG=logs/decisions.jsonl
